# Copiar para .env e ajustar se necessário.
# Caminho FORA da pasta Dropbox de propósito — evita sincronizar um ficheiro
# SQLite vivo (risco de corrupção). Ver README.md.
DATABASE_URL="file:/Users/bda/.gestao-economia-domestica/dev.db"

PORT=3333
CORS_ORIGIN="http://localhost:5173"

JWT_SECRET="troca-este-segredo-em-producao-0123456789"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DIAS=30

# Conta do gestor da aplicação — criada automaticamente no arranque do
# servidor se ainda não existir (ver garantirGestorInicial em auth.service.ts).
# É a única forma de criar a primeira conta do sistema, já que deixou de
# haver registo público. Depois de definir isto uma vez, podes deixar ficar
# ou remover — a conta já criada não é apagada se removeres estas linhas.
GESTOR_EMAIL="gestor@economia-domestica.local"
GESTOR_PASSWORD="troca-esta-password-0123456789"
